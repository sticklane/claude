{
  "$defs": {
    "surface": {
      "additionalProperties": false,
      "properties": {
        "behavioral_tests": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "content_sha256": {
          "description": "SHA-256 of the surface file at the time this row was written. Enforced as a freeze ONLY when disposition is 'retain' — that is the single case where a later edit to the file raises 'frozen content hash drift' and fails the check. On every other disposition this hash is a measurement snapshot that goes stale silently and by design, so never write an acceptance criterion that treats a non-'retain' row's content_sha256 as drift protection: it will pass vacuously.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "dependents": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "disposition": {
          "description": "What this surface's presence commits the repo to. 'retain' additionally freezes content_sha256, so a retained surface's file cannot change without refreshing its row; the other values carry no such freeze. 'retain' and 'repair' both require a non-empty behavioral_tests list.",
          "enum": [
            "retain",
            "repair",
            "hide-stub",
            "retire-dead",
            "measure-before-decision"
          ]
        },
        "identity": {
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "type": "string"
        },
        "replacement": {
          "type": [
            "string",
            "null"
          ]
        },
        "surface_type": {
          "enum": [
            "agent",
            "cli-command",
            "hook",
            "rule",
            "runtime",
            "skill",
            "test",
            "workflow"
          ]
        }
      },
      "required": [
        "behavioral_tests",
        "content_sha256",
        "dependents",
        "disposition",
        "identity",
        "path",
        "rationale",
        "replacement",
        "surface_type"
      ],
      "type": "object"
    }
  },
  "$id": "surface.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "frozen_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "git_blob_pin": {
          "const": 1
        },
        "manifest_type": {
          "const": "baseline"
        },
        "schema_version": {
          "const": 2
        },
        "surfaces": {
          "items": {
            "$ref": "#/$defs/surface"
          },
          "type": "array"
        }
      },
      "required": [
        "$schema",
        "frozen_sha256",
        "git_blob_pin",
        "manifest_type",
        "schema_version",
        "surfaces"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "fragment": {
          "minLength": 1,
          "type": "string"
        },
        "frozen_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "git_blob_pin": {
          "const": 1
        },
        "manifest_type": {
          "const": "fragment"
        },
        "schema_version": {
          "const": 2
        },
        "surfaces": {
          "items": {
            "$ref": "#/$defs/surface"
          },
          "type": "array"
        }
      },
      "required": [
        "$schema",
        "fragment",
        "frozen_sha256",
        "git_blob_pin",
        "manifest_type",
        "schema_version",
        "surfaces"
      ],
      "type": "object"
    }
  ]
}
