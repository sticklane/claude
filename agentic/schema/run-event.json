{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-toolkit.local/schema/run-event.json",
  "title": "Agentic run event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "prior_run_id",
    "timestamp_utc",
    "producer",
    "runtime",
    "repo_id",
    "issue_id",
    "attempt",
    "stage",
    "parent_event_id",
    "session_id",
    "base_commit",
    "result_commit",
    "artifact_paths",
    "finding_fingerprint",
    "disposition",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "$ref": "#/$defs/uuid_v7"
    },
    "run_id": {
      "$ref": "#/$defs/uuid_v7"
    },
    "prior_run_id": {
      "$ref": "#/$defs/uuid_v7_or_unknown"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "producer": {
      "$ref": "#/$defs/nonempty"
    },
    "runtime": {
      "$ref": "#/$defs/nonempty"
    },
    "repo_id": {
      "$ref": "#/$defs/nonempty"
    },
    "issue_id": {
      "$ref": "#/$defs/nonempty"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "$ref": "#/$defs/nonempty"
    },
    "parent_event_id": {
      "$ref": "#/$defs/uuid_v7_or_unknown"
    },
    "session_id": {
      "$ref": "#/$defs/nonempty"
    },
    "base_commit": {
      "$ref": "#/$defs/nonempty"
    },
    "result_commit": {
      "$ref": "#/$defs/nonempty"
    },
    "artifact_paths": {
      "oneOf": [
        {
          "const": "unknown"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        }
      ]
    },
    "finding_fingerprint": {
      "oneOf": [
        {
          "const": "unknown"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "disposition": {
      "$ref": "#/$defs/nonempty"
    },
    "reason": {
      "$ref": "#/$defs/nonempty"
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "uuid_v7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uuid_v7_or_unknown": {
      "oneOf": [
        {
          "const": "unknown"
        },
        {
          "$ref": "#/$defs/uuid_v7"
        }
      ]
    }
  }
}
