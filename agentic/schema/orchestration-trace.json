{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-toolkit.local/schema/orchestration-trace.json",
  "title": "Normalized native-orchestration trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "runtime",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "enum": [
        "claude-code",
        "codex",
        "antigravity"
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "run_id",
        "session_id",
        "parent_event_id",
        "stage",
        "outcome"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_event_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "stage": {
          "enum": [
            "ready",
            "claim",
            "prompt-screening",
            "isolation",
            "write-boundary",
            "worker-verdict",
            "review",
            "final-gate",
            "merge",
            "close",
            "cleanup"
          ]
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "atomic": {
          "type": "boolean"
        },
        "compact": {
          "type": "boolean"
        },
        "screened": {
          "type": "boolean"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "enum": [
            "verifier",
            "critic"
          ]
        },
        "worktree_removed": {
          "type": "boolean"
        },
        "claim_released": {
          "type": "boolean"
        }
      }
    }
  }
}
