#!/usr/bin/env bash
# janitor: reclaim stale session state and orchestration artifacts for swarm hygiene.
set -u

usage() {
  cat <<'USAGE'
Usage: janitor [--dry-run] [--scope all|claims|drain|handoff] [--handoff-stale-days N] [--json]

--dry-run                Do not mutate state (ledger still records dry-run actions)
--scope                  Target work surface (default: all)
--handoff-stale-days N   Minimum age in days before handoff is marked stale (default: 7)
--apply                  Apply changes (default: dry-run)
--json                   Print machine-readable JSON summary
--help                   Print this help
USAGE
  exit 64
}

scope="all"
dry_run=1
json=0
handoff_stale_days=7
while [ "$#" -gt 0 ]; do
  case "$1" in
    --scope)
      scope="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --apply)
      dry_run=0
      shift
      ;;
    --handoff-stale-days)
      handoff_stale_days="$2"
      shift 2
      ;;
    --json)
      json=1
      shift
      ;;
    --help|-h)
      usage
      ;;
    *)
      echo "janitor: unknown argument: $1" >&2
      usage
      ;;
  esac
done

valid_scope="all claims drain handoff"
case " $valid_scope " in
  *" $scope "*) ;;
  *)
    echo "janitor: invalid --scope '$scope'. Use all, claims, drain, or handoff." >&2
    exit 64
    ;;
esac

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || { echo "janitor: required command missing: $1" >&2; exit 1; }
}

need_cmd bd
need_cmd git
need_cmd jq
need_cmd python3

log_file=".beads/janitor-revival-log.jsonl"
mkdir -p "$(dirname "$log_file")"

log_event() {
  local etype="$1" iid="$2" ib="$3" ipath="$4" reason="$5" recover="$6"
  if [ "$dry_run" -eq 1 ]; then
    etype="dry_run"
  fi
  python3 - "$log_file" "$etype" "$iid" "$ib" "$ipath" "$reason" "$recover" <<'PY'
import sys
from datetime import datetime, timezone
log_path, etype, iid, ib, ipath, reason, recover = sys.argv[1:]
recoverable = str(recover).lower() in ("1", "true", "yes")
with open(log_path, "a", encoding="utf-8") as f:
  record = {
    "ts": datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z"),
    "type": etype,
    "id": iid or None,
    "branch": ib or None,
    "path": ipath or None,
    "reason": reason,
    "recoverable": recoverable,
  }
  f.write(__import__("json").dumps(record))
  f.write("\n")
PY
}

is_in_progress() {
  local issue_id="$1"
  [ -n "$issue_id" ] || return 1
  printf '%s\n' "$inprogress" | grep -Fxq "$issue_id"
}

is_closed_issue() {
  local issue_id="$1"
  [ -n "$issue_id" ] || return 1
  printf '%s\n' "$closed_issues" | grep -Fxq "$issue_id"
}

is_handoff_stale() {
  local updated_at="$1" days="$2"
  [ -n "$updated_at" ] || return 1
  [ -n "$days" ] || return 1
  python3 - "$updated_at" "$days" <<'PY'
import sys
from datetime import datetime, timezone
updated_at, days = sys.argv[1], float(sys.argv[2])
try:
  dt = datetime.fromisoformat(updated_at.replace("Z", "+00:00"))
except Exception:
  raise SystemExit(1)
age_days = (datetime.now(timezone.utc) - dt.astimezone(timezone.utc)).total_seconds() / 86400.0
  raise SystemExit(0 if age_days >= days else 1)
PY
}

detect_base_branch() {
  if base_ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null); then
    echo "${base_ref#refs/remotes/}"
    return 0
  fi
  for candidate in origin/main origin/master main master; do
    if git rev-parse --verify --quiet "$candidate" >/dev/null 2>&1; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

base_branch="$(detect_base_branch || true)"

branch_merge_status() {
  local branch_ref="$1"
  local ahead_count

  if [ -z "$base_branch" ]; then
    return 2
  fi
  if ! git rev-parse --verify --quiet "$branch_ref" >/dev/null 2>&1; then
    return 2
  fi
  if ! git rev-parse --verify --quiet "$base_branch" >/dev/null 2>&1; then
    return 2
  fi

  ahead_count="$(git rev-list --left-right --count "$base_branch...$branch_ref" 2>/dev/null | awk '{print $2}' || true)"
  if [ -z "$ahead_count" ]; then
    return 2
  fi
  if [ "$ahead_count" -eq 0 ]; then
    return 0
  fi
  return 1
}

is_orchestration_branch() {
  local branch_ref="$1"
  local branch_name
  case "$branch_ref" in
    refs/heads/drain/*|refs/heads/task/*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

issue_id_candidates() {
  local candidate="$1"
  while [ -n "$candidate" ]; do
    printf '%s\n' "$candidate"
    case "$candidate" in
      # bd sub-issue ids are dotted (agentic-868.6) and only '-' joins a
      # branch suffix, so a dotted segment is never split away.
      *-*) candidate="${candidate%-*}" ;;
      *) break ;;
    esac
  done
}

branch_checked_out_elsewhere() {
  local branch_ref="$1"
  local this_path="$2"
  local shared
  shared="$(awk -v branch="$branch_ref" -v path="$this_path" '
    $1=="worktree" {current_path=$2}
    $1=="branch" && $2==branch && current_path!="" && current_path!=path {count += 1}
    END {print count+0}
  ' "$tmpwt" 2>/dev/null || echo 0)"
  [ "$shared" -gt 0 ]
}

# --- preflight --------------------------------------------------------------
inprogress="$(bd list --status in_progress --json 2>/dev/null | jq -r '.[].id' | sort -u | xargs -n1 echo)"
closed_issues="$(bd list --status closed --json 2>/dev/null | jq -r '.[].id' | sort -u | xargs -n1 echo)"
open_handoffs="$(bd list --label handoff --status=open --json 2>/dev/null || echo '[]')"

claims="${inprogress}"  # alias kept for clarity

# --- claims sweep -----------------------------------------------------------
reclaimed_claims=0
skipped=0

actioned_claims=0
if [ "$scope" = "all" ] || [ "$scope" = "claims" ]; then
  # Claims list
  if [ -s .beads/session-claims ]; then
    tmp=$(mktemp)
    while IFS= read -r issue_id; do
      [ -n "$issue_id" ] || continue
      if is_in_progress "$issue_id"; then
        printf '%s\n' "$issue_id" >> "$tmp"
        continue
      fi
      log_event "reclaimed_claim" "$issue_id" "" "" "session claim orphaned; no in-progress row in bd" "false"
      if [ "$dry_run" -eq 0 ]; then
        (bin/session-claims rm "$issue_id") >/dev/null
      fi
      ((reclaimed_claims+=1))
    done < .beads/session-claims
    mv "$tmp" .beads/session-claims
  fi

  # Inflight list
  if [ -s .beads/session-inflight ]; then
    tmp=$(mktemp)
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      issue_id=${line%% *}
      if is_in_progress "$issue_id"; then
        printf '%s\n' "$line" >> "$tmp"
        continue
      fi
      log_event "reclaimed_claim" "$issue_id" "" "" "inflight marker orphaned; no in-progress row in bd" "false"
      if [ "$dry_run" -eq 0 ]; then
        :
      fi
      ((reclaimed_claims+=1))
    done < .beads/session-inflight
    mv "$tmp" .beads/session-inflight
  fi
fi

# --- handoff sweep ----------------------------------------------------------
if [ "$scope" = "all" ] || [ "$scope" = "handoff" ]; then
  if [ "$open_handoffs" = "[]" ]; then
    :
  else
    count_handoff=0
    while IFS= read -r item; do
      [ -n "$item" ] || continue
      hid="$(printf '%s' "$item" | jq -r '.id')"
      htitle="$(printf '%s' "$item" | jq -r '.title')"
      hupdated="$(printf '%s' "$item" | jq -r '.updated_at // .metadata.updated_at // empty')"

      tracked_live=0
      if tracks=$(bd dep list "$hid" --direction=up -t tracks --json 2>/dev/null); then
        while IFS= read -r tid; do
          [ -n "$tid" ] || continue
          if is_in_progress "$tid"; then
            tracked_live=1
            break
          fi
        done < <(printf '%s' "$tracks" | jq -r '.[]?.id // .depends_on_id // empty')
      fi

      if [ "$tracked_live" -eq 1 ]; then
        continue
      fi

      if is_handoff_stale "$hupdated" "$handoff_stale_days"; then
        ((count_handoff+=1))
        log_event "skipped_ambiguous" "$hid" "" "" "handoff stale > ${handoff_stale_days}d and no live tracked issue" "true"
        if [ "$dry_run" -eq 0 ]; then
          bd comment "$hid" "[janitor] stale-handoff candidate: no live tracked sessions and no touch in >${handoff_stale_days}d; please resume or close"
          # Conservative: do not auto-close. Keeping handoff open preserves context.
        fi
        echo "stale handoff: $hid - $htitle"
      fi
    done < <(printf '%s' "$open_handoffs" | jq -c '.[]')
    skipped=$((skipped+count_handoff))
  fi
fi

# --- worktree sweep ---------------------------------------------------------
reclaimed_worktrees=0
salvaged_worktrees=0
if [ "$scope" = "all" ] || [ "$scope" = "drain" ]; then
  tmpwt=$(mktemp)
  git worktree list --porcelain > "$tmpwt"
  shared_checkout="$(awk '$1=="worktree" {print $2; exit}' "$tmpwt")"
  did_remove=0
  history_scan_limit=50

  worktree_idle_minutes="${JANITOR_WORKTREE_IDLE_MINUTES:-1440}"

  recently_active() {
    local wt_path="$1"
    python3 - "$wt_path" "$worktree_idle_minutes" <<'PY'
import os
import sys
import time

path, minutes = sys.argv[1], float(sys.argv[2])
gitlink = os.path.join(path, ".git")
targets = [path, gitlink]
gitdir = None
if os.path.isdir(gitlink):
  gitdir = gitlink
elif os.path.isfile(gitlink):
  try:
    with open(gitlink, encoding="utf-8") as handle:
      for line in handle:
        if line.startswith("gitdir:"):
          gitdir = line.split(":", 1)[1].strip()
          break
  except OSError:
    gitdir = None
if gitdir:
  if not os.path.isabs(gitdir):
    gitdir = os.path.join(path, gitdir)
  targets += [gitdir, os.path.join(gitdir, "HEAD"), os.path.join(gitdir, "index")]
newest = 0.0
for target in targets:
  try:
    newest = max(newest, os.stat(target).st_mtime)
  except OSError:
    continue
raise SystemExit(0 if (time.time() - newest) < minutes * 60.0 else 1)
PY
  }

  is_orchestrator_location() {
    local wt_path="$1"
    case "$wt_path" in
      /tmp/*|/private/tmp/*) return 0 ;;
      "$shared_checkout"/.claude/worktrees/*) return 0 ;;
    esac
    return 1
  }

  content_state() {
    local wt_path="$1" rev="$2" commit
    if [ -z "$(git -C "$wt_path" status --porcelain)" ]; then
      echo clean
      return
    fi
    if [ -z "$(git -C "$wt_path" ls-files --others --exclude-standard)" ]; then
      while IFS= read -r commit; do
        [ -n "$commit" ] || continue
        if git -C "$wt_path" diff --quiet "$commit" 2>/dev/null; then
          echo reconstructible
          return
        fi
      done < <(git -C "$wt_path" rev-list --max-count="$history_scan_limit" "$rev" 2>/dev/null)
    fi
    echo unique
  }

  salvage_content() {
    local wt_path="$1" label="$2" parent="$3" index tree commit
    index="$(mktemp -u)"
    GIT_INDEX_FILE="$index" git -C "$wt_path" add -A >/dev/null 2>&1 || { rm -f "$index"; return 1; }
    tree="$(GIT_INDEX_FILE="$index" git -C "$wt_path" write-tree 2>/dev/null)"
    rm -f "$index"
    [ -n "$tree" ] || return 1
    if [ -n "$parent" ] && git -C "$wt_path" rev-parse --verify --quiet "$parent" >/dev/null 2>&1; then
      commit="$(git -C "$wt_path" commit-tree "$tree" -p "$parent" -m "janitor salvage of $label" 2>/dev/null)"
    else
      commit="$(git -C "$wt_path" commit-tree "$tree" -m "janitor salvage of $label" 2>/dev/null)"
    fi
    [ -n "$commit" ] || return 1
    git branch --force "salvage/$label" "$commit" >/dev/null 2>&1 || return 1
    printf 'salvage/%s\n' "$label"
  }

  skip_worktree() {
    log_event "skipped_ambiguous" "$1" "$2" "$3" "$4" "$5"
    ((skipped+=1))
  }

  process_worktree() {
    local wt_path="$1" wt_branch="$2" wt_detached="$3"
    local issue_id="" label="" rev="" state="" salvage_ref="" head_sha=""
    local candidate="" live_id="" closed_id=""
    local eligible=0

    if [ "$wt_path" = "$shared_checkout" ]; then
      skip_worktree "" "$wt_branch" "$wt_path" "skip cleanup: shared checkout is never a removal candidate" "false"
      return
    fi

    if [ ! -d "$wt_path" ]; then
      skip_worktree "" "$wt_branch" "$wt_path" "stale branch path missing" "false"
      return
    fi

    if ! is_orchestrator_location "$wt_path"; then
      skip_worktree "" "$wt_branch" "$wt_path" "candidate skipped: non-orchestrator worktree location" "false"
      return
    fi

    if [ "$wt_detached" -eq 1 ]; then
      if recently_active "$wt_path"; then
        skip_worktree "" "" "$wt_path" "skip cleanup: detached worktree active within ${worktree_idle_minutes}m" "true"
        echo "left alone, detached worktree still active: $wt_path"
        return
      fi
      head_sha="$(git -C "$wt_path" rev-parse --verify --quiet HEAD 2>/dev/null || true)"
      if [ -z "$head_sha" ]; then
        skip_worktree "" "" "$wt_path" "skip cleanup: detached worktree has no resolvable HEAD" "true"
        return
      fi
      label="detached-$(git -C "$wt_path" rev-parse --short HEAD)"
      if [ "$dry_run" -eq 0 ] && ! git branch --force "salvage/$label" "$head_sha" >/dev/null 2>&1; then
        skip_worktree "" "" "$wt_path" "skip cleanup: detached worktree commits could not be branched" "true"
        return
      fi
      wt_branch="refs/heads/salvage/$label"
      rev="$head_sha"
      eligible=1
    else
      case "$wt_branch" in
        refs/heads/*) ;;
        *)
          skip_worktree "" "$wt_branch" "$wt_path" "skip non-checkout worktree branch entry" "false"
          return
          ;;
      esac

      if ! is_orchestration_branch "$wt_branch"; then
        skip_worktree "" "$wt_branch" "$wt_path" "candidate skipped: branch does not match orchestration patterns (drain|task)" "false"
        return
      fi

      label="${wt_branch#refs/heads/}"
      label="${label#*/}"

      while IFS= read -r candidate; do
        [ -n "$candidate" ] || continue
        if [ -z "$live_id" ] && is_in_progress "$candidate"; then
          live_id="$candidate"
        fi
        if [ -z "$closed_id" ] && is_closed_issue "$candidate"; then
          closed_id="$candidate"
        fi
      done < <(issue_id_candidates "$label")
      issue_id="${live_id:-${closed_id:-$label}}"

      if [ -n "$live_id" ]; then
        skip_worktree "$issue_id" "$wt_branch" "$wt_path" "skip cleanup: issue still in progress" "false"
        return
      fi

      if branch_checked_out_elsewhere "$wt_branch" "$wt_path"; then
        skip_worktree "$issue_id" "$wt_branch" "$wt_path" "skip cleanup: branch checked out by another worktree" "false"
        return
      fi

      rev="$wt_branch"
      if [ -n "$closed_id" ] || branch_merge_status "$wt_branch"; then
        eligible=1
      fi
      if [ "$eligible" -eq 0 ]; then
        skip_worktree "$issue_id" "$wt_branch" "$wt_path" "skip cleanup: issue neither closed nor branch merged into ${base_branch:-base}" "true"
        return
      fi
    fi

    state="$(content_state "$wt_path" "$rev")"

    if [ "$state" = "unique" ]; then
      if [ "$dry_run" -eq 1 ]; then
        log_event "removed_worktree" "$issue_id" "$wt_branch" "$wt_path" "dry-run: would salvage unique content to salvage/$label then remove" "true"
        reclaimed_worktrees=$((reclaimed_worktrees+1))
        return
      fi
      salvage_ref="$(salvage_content "$wt_path" "$label" "$rev" || true)"
      if [ -z "$salvage_ref" ]; then
        skip_worktree "$issue_id" "$wt_branch" "$wt_path" "skip cleanup: unique worktree content could not be salvaged" "true"
        return
      fi
      salvaged_worktrees=$((salvaged_worktrees+1))
      echo "salvaged worktree content to $salvage_ref ($wt_path)"
    fi

    if [ "$dry_run" -eq 1 ]; then
      log_event "removed_worktree" "$issue_id" "$wt_branch" "$wt_path" "dry-run: would remove $state worktree" "true"
      reclaimed_worktrees=$((reclaimed_worktrees+1))
      return
    fi

    did_remove=1
    if git worktree remove --force "$wt_path" >/dev/null 2>&1; then
      reclaimed_worktrees=$((reclaimed_worktrees+1))
      log_event "removed_worktree" "$issue_id" "$wt_branch" "$wt_path" "$state worktree removed; branch retained as the archive" "false"
    else
      skip_worktree "$issue_id" "$wt_branch" "$wt_path" "worktree remove failed" "true"
    fi
  }

  wt_path=""
  wt_branch=""
  wt_detached=0
  flush_worktree() {
    if [ -n "$wt_path" ] && { [ "$wt_detached" -eq 1 ] || [ -n "$wt_branch" ]; }; then
      process_worktree "$wt_path" "$wt_branch" "$wt_detached"
    fi
    wt_path=""
    wt_branch=""
    wt_detached=0
  }
  while IFS= read -r line; do
    case "$line" in
      worktree\ *)
        flush_worktree
        wt_path="${line#worktree }"
        ;;
      branch\ *)
        wt_branch="${line#branch }"
        ;;
      detached*)
        wt_detached=1
        ;;
      "")
        flush_worktree
        ;;
    esac
  done < "$tmpwt"
  flush_worktree
  rm -f "$tmpwt"
  if [ "$did_remove" -eq 1 ]; then
    git worktree prune
  fi
fi

actioned_claims=$((reclaimed_claims + reclaimed_worktrees))

if [ "$json" -eq 1 ]; then
  printf '{"scope":"%s","dry_run":%s,"reclaimed_claims":%s,"reclaimed_worktrees":%s,"salvaged_worktrees":%s,"skipped":%s,"handoff_scope":%s}\n' \
    "$scope" "$([ "$dry_run" -eq 1 ] && echo true || echo false)" "$reclaimed_claims" "$reclaimed_worktrees" "$salvaged_worktrees" "$skipped" "${open_handoffs}"
else
  echo "janitor summary:"
  echo "  scope=$scope"
  echo "  dry_run=$([ "$dry_run" -eq 1 ] && echo true || echo false)"
  echo "  reclaimed_claims=$reclaimed_claims"
  echo "  reclaimed_worktrees=$reclaimed_worktrees"
  echo "  salvaged_worktrees=$salvaged_worktrees"
  echo "  skipped_or_ambiguous=$skipped"
fi

exit 0
