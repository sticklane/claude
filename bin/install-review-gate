#!/usr/bin/env bash
# install-review-gate — install, remove, or report the review-gate pre-commit
# hook as this machine's global git hook.
#
# Usage:
#   install-review-gate install [hooks-dir]
#                        Put the hook in <hooks-dir> (default ~/.git-hooks) and
#                        point core.hooksPath at it. Refuses, rather than
#                        clobbering, a core.hooksPath already set elsewhere.
#   install-review-gate uninstall [hooks-dir]
#                        Remove the hook this installer put there, and unset
#                        core.hooksPath when it points at that hook's directory.
#   install-review-gate status
#                        Print whether the hook is installed, the hooks
#                        directory, and the current core.hooksPath.
#
# Running it twice is the same as running it once. core.hooksPath REPLACES a
# repository's own hooks; the installed hook chains to them so that stays
# invisible.
set -u
set -o pipefail

DEFAULT_DIR="$HOME/.git-hooks"
BIN_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)"
SOURCE="$(cd "$BIN_DIR/../hooks/review-gate" 2>/dev/null && pwd -P)/pre-commit"

die() {
  printf 'install-review-gate: %s\n' "$1" >&2
  exit 1
}

expand_home() { # expand_home <path>
  case "$1" in
    '~') printf '%s' "$HOME" ;;
    '~/'*) printf '%s%s' "$HOME" "${1#\~}" ;;
    *) printf '%s' "$1" ;;
  esac
}

absolute() { # absolute <path>
  case "$1" in
    /*) printf '%s' "$1" ;;
    *) printf '%s/%s' "$PWD" "$1" ;;
  esac
}

physical() { # physical <path>
  ( cd "$1" 2>/dev/null && pwd -P ) || printf '%s' "$1"
}

same_dir() { # same_dir <path> <path>
  [ "$(physical "$1")" = "$(physical "$2")" ]
}

is_ours() { # is_ours <path> — a review-gate hook, including a broken symlink
  if [ -L "$1" ]; then
    case "$(readlink "$1")" in */hooks/review-gate/pre-commit) return 0 ;; esac
  fi
  [ -f "$1" ] && head -n 5 "$1" 2>/dev/null | grep -q 'review-gate pre-commit hook'
}

configured_path() {
  git config --global --get core.hooksPath 2>/dev/null || true
}

# target_dir prints the hooks directory a subcommand acts on: the argument when
# given, the configured one when set, the default otherwise.
target_dir() { # target_dir <argument>
  local arg="$1" configured
  if [ -n "$arg" ]; then
    absolute "$(expand_home "$arg")"
    return 0
  fi
  configured="$(configured_path)"
  if [ -n "$configured" ]; then
    absolute "$(expand_home "$configured")"
  else
    printf '%s' "$DEFAULT_DIR"
  fi
}

cmd_install() {
  local dir="$1" configured
  [ -f "$SOURCE" ] || die "hook source not found at $SOURCE"
  configured="$(configured_path)"
  if [ -n "$configured" ] && ! same_dir "$(expand_home "$configured")" "$dir"; then
    die "core.hooksPath is already set to '$configured'.
Installing here would disable that hook path for every repository, so nothing
was changed. Point this installer at that directory instead:
    install-review-gate install '$configured'
or clear the setting yourself with:
    git config --global --unset core.hooksPath"
  fi
  mkdir -p "$dir" || die "cannot create $dir"
  if ! ln -sfn "$SOURCE" "$dir/pre-commit" 2>/dev/null; then
    command -v review-gate >/dev/null 2>&1 ||
      die "cannot symlink into $dir, and a copy there could not find
bin/review-gate: the hook locates that tool through the symlink it was
installed as, or on PATH, and it is on neither. Put $BIN_DIR on PATH and
try again."
    cp "$SOURCE" "$dir/pre-commit" || die "cannot write $dir/pre-commit"
    chmod 755 "$dir/pre-commit" || die "cannot make $dir/pre-commit executable"
  fi
  git config --global core.hooksPath "$dir" ||
    die "cannot set core.hooksPath"
  printf 'installed %s\ncore.hooksPath: %s\n' "$dir/pre-commit" "$dir"
  printf '%s\n' "core.hooksPath replaces each repository's .git/hooks. The
installed hook chains to a repository's own pre-commit hook, but NO other hook
type does: commit-msg, prepare-commit-msg, pre-push, post-commit and the rest
stop running in every repository until this is uninstalled."
}

cmd_uninstall() {
  local dir="$1" hook="$1/pre-commit" configured
  configured="$(configured_path)"
  if ! is_ours "$hook"; then
    printf 'no review-gate hook at %s; nothing removed\n' "$hook"
    [ -z "$configured" ] ||
      printf 'core.hooksPath is still set to: %s\n' "$configured"
    return 0
  fi
  rm -f "$hook" || die "cannot remove $hook"
  if [ -n "$configured" ] && same_dir "$(expand_home "$configured")" "$dir"; then
    git config --global --unset core.hooksPath || true
    printf 'removed %s and unset core.hooksPath\n' "$hook"
  else
    printf 'removed %s; core.hooksPath (%s) was left alone\n' \
      "$hook" "${configured:-unset}"
  fi
}

cmd_status() {
  local dir="$1" configured installed=no
  configured="$(configured_path)"
  if is_ours "$dir/pre-commit" && [ -n "$configured" ] &&
    same_dir "$(expand_home "$configured")" "$dir"; then
    installed=yes
  fi
  printf 'installed: %s\n' "$installed"
  printf 'hooks dir: %s\n' "$dir"
  printf 'core.hooksPath: %s\n' "${configured:-(unset)}"
}

subcommand="${1:-status}"
shift || true
argument="${1:-}"

case "$subcommand" in
  install) cmd_install "$(target_dir "${argument:-$DEFAULT_DIR}")" ;;
  uninstall) cmd_uninstall "$(target_dir "$argument")" ;;
  status) cmd_status "$(target_dir "$argument")" ;;
  *) die "usage: install-review-gate {install|uninstall|status} [hooks-dir]" ;;
esac
