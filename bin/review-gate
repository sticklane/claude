#!/usr/bin/env bash
# review-gate — record and check adversarial reviews against a staged diff.
#
# WHAT THIS GUARANTEES: that recording a review is a deliberate, separate act
# before a commit lands. Nothing more. `record` accepts any non-blank text and
# the marker is an ordinary file, so an agent with shell access can satisfy or
# forge it without reviewing anything. It converts an oversight into a choice;
# it is not proof that a review happened, and must not be described as one.
# Establishing that would require the gate to run the review itself, out of the
# committing agent's control.
#
# Usage:
#   review-gate key      Print the key for the staged diff (16 hex chars).
#                        Exits 1 and prints nothing when that diff is empty.
#   review-gate check    Exit 0 when a review is recorded for that key, when
#                        the diff is empty, or when no marker could ever be
#                        written here; exit 1 when a review is missing; exit 2
#                        when the key cannot be computed at all (the cause goes
#                        to stderr).
#   review-gate record   Read a review verdict on stdin and store it against
#                        that key. Exits 1 on empty stdin.
#   review-gate show [key]
#                        Print the recorded verdict for key, or for the staged
#                        diff when no key is provided. Exits 1 when the key
#                        exists but no marker does.
#
# The key is always `git diff --cached`. Inside the pre-commit hook this tool
# exists for, that diff is what the commit will contain — plain, `git commit -a`,
# and pathspec commits alike, because git stages all three before running it.
#
# CAVEAT, --amend: the key covers what is staged against HEAD, not the whole
# commit the amend produces. Amending with something staged is gated on that
# staged content; a reword with nothing staged has an empty diff and is not
# gated at all.
#
# REVIEW_GATE=0 in the environment turns the gate off: `check` exits 0 without
# consulting anything. That is the deliberate escape hatch for a commit you
# have decided not to gate, and the pre-commit hook honors it too.
# `git commit --no-verify` skips the hook outright.
#
# Markers live at <git-common-dir>/agentic-review/<key>, inside .git, so they
# are never committed and are shared by every worktree of the repository.
#
# SELF-REVIEW: `record` only runs where the diff is staged, so whoever records a
# verdict is whoever authored the diff. Every marker is stamped with that one
# observation and nothing more, and the pre-commit hook repeats it on every
# gated commit. Whether an independent reviewer produced the verdict is not
# observable here — an attended session relays a critic's verdict through the
# same `record` call a worker uses to sign off on its own diff.
#
# No recorder identity is stamped, because the environment offers none that is
# true: the harness hands a dispatched agent its dispatcher's
# CLAUDE_CODE_SESSION_ID verbatim, and CLAUDE_CODE_CHILD_SESSION is set in the
# dispatching session too (both measured 2026-07-25). A field naming the wrong
# agent is worse than no field, because a reader would trust it.
set -u
set -o pipefail

die() {
  printf 'review-gate: %s\n' "$1" >&2
  exit 1
}

warn() {
  printf 'review-gate: %s\n' "$1" >&2
}

common_dir() {
  local dir
  dir="$(git rev-parse --git-common-dir 2>/dev/null)" || return 1
  case "$dir" in
    /*) printf '%s' "$dir" ;;
    *) printf '%s/%s' "$PWD" "$dir" ;;
  esac
}

digest() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum
  else
    return 1
  fi
}

key_failure_cause() {
  if command -v shasum >/dev/null 2>&1 || command -v sha256sum >/dev/null 2>&1; then
    printf 'git could not produce the diff this commit would contain'
  else
    printf 'no shasum or sha256sum on PATH'
  fi
}

# reviewable_diff prints the staged diff minus generated files. A tracker
# export is rewritten by its own pre-commit hook mid-commit, which would change
# the key after a review was recorded and refuse the commit.
reviewable_diff() {
  git diff --cached -- ':(top)' ':(exclude,top).beads/issues.jsonl' 2>/dev/null
}

# staged_key prints the key, or returns 1 for a genuinely empty diff and 2 when
# the key cannot be computed. The two must never collapse into one: an
# uncomputable key means the gate is blind, not that there is nothing to review.
staged_key() {
  local diff key
  diff="$(reviewable_diff)" || return 2
  [ -n "$diff" ] || return 1
  key="$(reviewable_diff | digest | cut -c1-16)" || return 2
  case "$key" in '' | *[!0-9a-f]*) return 2 ;; esac
  printf '%s' "$key"
}

nearest_existing_dir() {
  local dir="$1" parent
  while [ ! -d "$dir" ]; do
    parent="$(dirname "$dir")"
    [ "$parent" != "$dir" ] || break
    dir="$parent"
  done
  printf '%s' "$dir"
}

marker_path() {
  local key="$1" dir
  dir="$(common_dir)" || return 1
  printf '%s/agentic-review/%s' "$dir" "$key"
}

cmd_key() {
  local key status
  key="$(staged_key)"
  status=$?
  [ "$status" -eq 0 ] || exit "$status"
  printf '%s\n' "$key"
}

cmd_check() {
  local key status marker probe
  [ "${REVIEW_GATE:-1}" != "0" ] || exit 0
  key="$(staged_key)"
  status=$?
  [ "$status" -ne 1 ] || exit 0
  if [ "$status" -ne 0 ]; then
    warn "$(key_failure_cause); denying, because a gate that cannot see the diff is not a gate"
    return 2
  fi
  marker="$(marker_path "$key")" || exit 0
  [ -f "$marker" ] && return 0
  # An unrecordable marker must not become a permanent deny: if a review
  # could never be written here, allow rather than wedge the repository.
  probe="$(nearest_existing_dir "$(dirname "$marker")")"
  [ -w "$probe" ] || exit 0
  return 1
}

MARKER_STAMP='review-gate-kind: self-review (recorded from the tree that staged this diff)'

cmd_record() {
  local verdict key status marker
  verdict="$(cat)"
  [ -n "${verdict//[[:space:]]/}" ] ||
    die "refusing to record an empty review verdict; pipe the review on stdin"
  key="$(staged_key)"
  status=$?
  [ "$status" -ne 1 ] ||
    die "nothing staged; stage the change you had reviewed, then record"
  [ "$status" -eq 0 ] || die "$(key_failure_cause)"
  marker="$(marker_path "$key")" || die "not inside a git repository"
  mkdir -p "$(dirname "$marker")" || die "cannot create marker directory"
  {
    printf '%s\n\n' "$MARKER_STAMP"
    printf '%s\n' "$verdict"
  } > "$marker" || die "cannot write marker $marker"
}

cmd_show() {
  local key status marker
  key="$1"
  if [ -z "$key" ]; then
    key="$(staged_key)"
    status=$?
    [ "$status" -ne 1 ] || die "nothing staged; stage the change you want to inspect"
    [ "$status" -eq 0 ] || die "$(key_failure_cause)"
  fi
  marker="$(marker_path "$key")" || die "not inside a git repository"
  [ -r "$marker" ] || return 1
  cat "$marker"
}

git rev-parse --git-common-dir >/dev/null 2>&1 ||
  die "not inside a git repository"

subcommand="${1:-}"
shift || true

for arg in "$@"; do
  [ -z "$arg" ] || die "unknown option: $arg"
done

case "$subcommand" in
  key) cmd_key ;;
  check) cmd_check ;;
  record) cmd_record ;;
  show) cmd_show "${1-}" ;;
  *) die "usage: review-gate {key|check|record|show}" ;;
esac
